<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Go</RootNamespace>
    <AssemblyName>Tamp.Go</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.Go</PackageId>
    <Description>Wrapper for the go CLI — the Go toolchain build driver. Typed verb surface (Build, Test, Vet, Run, Install, Generate, Clean, Fmt, List, Env, Version, Mod, Work, Raw) mirroring Tamp.Cargo conventions. First-class cross-compilation via GOOS/GOARCH/CGO_ENABLED environment emission, ldflags/version-stamping helpers, build tags, -mod modes, and the race/cover build flags. Tamp.Core 1.5.0+ required for the InternalsVisibleTo grant.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TampCorePath)" Condition="'$(TampCoreMode)' == 'project'" />
    <PackageReference Include="Tamp.Core" Condition="'$(TampCoreMode)' == 'package'" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
